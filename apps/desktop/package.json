{
  "name": "@browser-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Span contributors",
  "description": "Span \u2014 a workspace for your next idea. Build, preview, and refine local projects with AI.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack": "pnpm build && electron-builder --dir",
    "pack:prepared": "electron-builder --dir",
    "dist:win": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "@browser-agent/daemon": "workspace:*",
    "@browser-agent/shared": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "zod": "^4.1.5"
  },
  "build": {
    "appId": "com.browseragent.desktop",
    "productName": "Span",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../daemon/node_modules/@vscode/tree-sitter-wasm",
        "to": "codebase-map",
        "filter": [
          "LICENSE",
          "cgmanifest.json",
          "wasm/tree-sitter.js",
          "wasm/tree-sitter.wasm",
          "wasm/tree-sitter-python.wasm",
          "wasm/tree-sitter-typescript.wasm",
          "wasm/tree-sitter-tsx.wasm"
        ]
      },
      {
        "from": "build/span.png",
        "to": "span.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/span.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/span.ico",
      "uninstallerIcon": "build/span.ico",
      "installerHeaderIcon": "build/span.ico",
      "shortcutName": "Span"
    }
  }
}
